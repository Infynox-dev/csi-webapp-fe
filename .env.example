# API (build-time for Docker / Vite)
# Staging/prod (Coolify FE build arg):
# VITE_API_BASE_URL=https://staging-api.csimkdyouth.infynox.net/api
#
# Local BE (python main.py on :7000) — Vite proxies /api → 127.0.0.1:7000
VITE_API_BASE_URL=/api
VITE_USE_LOCAL_API=true

# Observability — leave unset for quiet local dev
# VITE_SENTRY_DSN=https://<key>@bugtracker.infynox.net/<project_id>
# VITE_FARO_URL=https://faro-collector-...grafana.net/collect/<app-key>
# VITE_FARO_APP_NAME=csi-webapp-staging
# VITE_ENVIRONMENT=staging
# VITE_RELEASE=csi-fe@<git-sha>

# Docker build-only (not VITE_*) for sourcemap upload to Urgentry
# SENTRY_URL=https://bugtracker.infynox.net
# SENTRY_AUTH_TOKEN=<urgentry PAT or project token>
# SENTRY_ORG=urgentry-org
# SENTRY_PROJECT=csi-fe-staging
#
# NOTE: DATABASE_URL / REDIS_URL / STORAGE_* / SECRET_KEY belong in
# csi-project-be/.env (Coolify BE runtime), not this FE file.
